{
  "name": "finbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:test:prepare": "tsx server/db/prepare-test.ts",
    "start:api": "node server-dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "dev:bot": "tsx server/bot/telegram.ts",
    "bot:prune": "tsx server/bot/prune.ts",
    "test:bot": "node --import tsx --test tests/bot.test.ts",
    "pdf:install": "playwright install chromium",
    "dev:reminders": "tsx server/reminderWorker.ts",
    "start:reminders": "node server-dist/server/reminderWorker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fontsource/inter": "5.2.8",
    "@hookform/resolvers": "5.7.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.5",
    "lucide-react": "1.31.0",
    "pg": "^8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router-dom": "^7.9.0",
    "recharts": "3.8.0",
    "tailwindcss": "4.2.1",
    "zod": "3.25.76",
    "zustand": "^5.0.8",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.1"
  }
}
