VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3001
DATABASE_URL=postgres://finbot:finbot@127.0.0.1:5432/finbot
TEST_DATABASE_URL=postgres://finbot:finbot@127.0.0.1:5432/finbot_test
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development
SESSION_COOKIE_NAME=finbot_session
SESSION_TTL_DAYS=7
APP_DATE_OVERRIDE=

# Phase 5A: optional Telegram/AI. Keep secrets in .env, never commit them.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required only for webhook mode; 32+ random URL-safe characters.
TELEGRAM_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
BOT_ACTION_TTL_MINUTES=15
